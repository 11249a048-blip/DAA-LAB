      "source": [
        "%%bash\n",
        "\n",
        "cat <<EOF > dijkstra.c\n",
        "#include <stdio.h>\n",
        "#include <limits.h>\n",
        "#include <stdbool.h>\n",
        "\n",
        "#define V 6\n",
        "\n",
        "int min_dist(int dist[], bool visited[]) {\n",
        "    int minimum = INT_MAX, ind = -1;\n",
        "\n",
        "    for (int i = 0; i < V; i++) {\n",
        "        if (!visited[i] && dist[i] < minimum) {\n",
        "            minimum = dist[i];\n",
        "            ind = i;\n",
        "        }\n",
        "    }\n",
        "    return ind;\n",
        "}\n",
        "\n",
        "void greedy_dijkstra(int graph[V][V], int src) {\n",
        "    int dist[V];\n",
        "    bool visited[V];\n",
        "\n",
        "    for (int i = 0; i < V; i++) {\n",
        "        dist[i] = INT_MAX;\n",
        "        visited[i] = false;\n",
        "    }\n",
        "\n",
        "    dist[src] = 0;\n",
        "\n",
        "    for (int count = 0; count < V - 1; count++) {\n",
        "        int m = min_dist(dist, visited);\n",
        "        if (m == -1) break; // safety check\n",
        "\n",
        "        visited[m] = true;\n",
        "\n",
        "        for (int j = 0; j < V; j++) {\n",
        "            if (!visited[j] && graph[m][j] && dist[m] != INT_MAX &&\n",
        "                dist[m] + graph[m][j] < dist[j]) {\n",
        "                dist[j] = dist[m] + graph[m][j];\n",
        "            }\n",
        "        }\n",
        "    }\n",
        "\n",
        "    printf(\"Vertex\\tDistance from source\\n\");\n",
        "    for (int i = 0; i < V; i++) {\n",
        "        printf(\"%c\\t%d\\n\", 'A' + i, dist[i]);\n",
        "    }\n",
        "}\n",
        "\n",
        "int main() {\n",
        "    int graph[V][V] = {\n",
        "        {0, 1, 2, 0, 0, 0},\n",
        "        {1, 0, 0, 5, 1, 0},\n",
        "        {2, 0, 0, 2, 3, 0},\n",
        "        {0, 5, 2, 0, 2, 2},\n",
        "        {0, 1, 3, 2, 0, 1},\n",
        "        {0, 0, 0, 2, 1, 0}\n",
        "    };\n",
        "\n",
        "    greedy_dijkstra(graph, 0);\n",
        "    return 0;\n",
        "}\n",
        "EOF\n",
        "\n",
        "gcc dijkstra.c -o dijkstra\n",
        "./dijkstra"
      ]
